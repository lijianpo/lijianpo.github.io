---
import { pageUrl } from '../lib/posts';
interface Props { current: number; total: number; }
const { current, total } = Astro.props;
---
{total > 1 && <nav class="pagination" aria-label="文章分页">
  {current > 1 ? <a href={pageUrl(current - 1)} rel="prev">← 上一页</a> : <span />}
  <span class="page-position">{current} / {total}</span>
  {current < total ? <a href={pageUrl(current + 1)} rel="next">下一页 →</a> : <span />}
</nav>}
