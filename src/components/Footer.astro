---
import { site } from '../site.config';
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';

const { revision, builtAt } = __BLOG_BUILD_INFO__;
const commit = revision.match(/^([a-f0-9]{40})(-dirty)?$/i);
const shortRevision = commit ? `${commit[1].slice(0, 7)}${commit[2] ?? ''}` : revision;
const commitUrl = commit ? `${site.repository}/commit/${commit[1]}` : undefined;
const parts = Object.fromEntries(new Intl.DateTimeFormat('en-CA', {
  timeZone: site.timeZone,
  year: 'numeric', month: '2-digit', day: '2-digit',
  hour: '2-digit', minute: '2-digit', second: '2-digit',
  hourCycle: 'h23', timeZoneName: 'shortOffset',
}).formatToParts(new Date(builtAt)).map(({ type, value }) => [type, value]));
const buildTime = `${parts.year}-${parts.month}-${parts.day} ${parts.hour}:${parts.minute}:${parts.second} ${parts.timeZoneName.replace('GMT', 'UTC')}`;
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top"><a class="wordmark" href="/" aria-label={`${site.name} 首页`}><BrandMark /><span>{site.name}</span></a><p class="footer-note">保持好奇，持续记录。</p><a class="footer-about" href="/about/">关于这个小站 <Icon name="arrow" size={18} /></a></div>
    <div class="footer-bottom">
      <div class="footer-identity">
        <span class="copyright">© {new Date().getFullYear()} {site.name}</span>
        <p class="footer-build" data-pagefind-ignore>
          <span class="footer-version">版本 {commitUrl
            ? <a class="build-revision" href={commitUrl} title={revision} data-revision={revision} target="_blank" rel="noopener noreferrer"><code>{shortRevision}</code></a>
            : <span class="build-revision" title={revision} data-revision={revision}><code>{shortRevision}</code></span>}
          </span>
          <span class="footer-build-separator" aria-hidden="true">·</span>
          <span class="footer-build-time">{import.meta.env.DEV
            ? '开发预览'
            : <>最后编译 <time datetime={builtAt}>{buildTime}</time></>}
          </span>
        </p>
      </div>
      <div class="footer-links"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={14} /></a><a href="/rss.xml"><Icon name="rss" size={16} /> RSS</a><a href="/archives/">文章归档</a></div>
    </div>
  </div>
</footer>
