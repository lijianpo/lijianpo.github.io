---
import { site } from '../site.config';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-note"><span class="tiny-cross" aria-hidden="true">+</span><span>保持好奇，持续记录。</span></div>
    <div class="footer-bottom">
      <span class="copyright">© {new Date().getFullYear()} {site.name}</span>
      <div class="footer-links"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={12} /></a><a href="/rss.xml"><Icon name="rss" size={14} /> RSS</a><span class="built-with">Built with Astro</span></div>
    </div>
  </div>
</footer>
