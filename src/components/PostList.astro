---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl, readingMinutes } from '../lib/posts';
import Icon from './Icon.astro';
import PostThumbnail from './PostThumbnail.astro';
interface Props { posts: CollectionEntry<'posts'>[]; featured?: boolean; switchable?: boolean; id?: string; }
const { posts, featured = false, switchable = false, id } = Astro.props;
---
{posts.length ? <ul id={id} class:list={['post-list', { 'post-list-switchable': switchable }]}>
  {posts.map((post, index) => <li class:list={['post-row', { 'post-featured': featured && index === 0 }]}>
    <article class="post-card">
      <a class="post-artwork-link" href={postUrl(post.id)} tabindex="-1" aria-hidden="true"><PostThumbnail seed={post.id} cover={post.data.cover} priority={index === 0} /></a>
      <div class="post-summary">
        <span class="post-kicker">{featured && index === 0 ? '最新发布' : '记录与思考'}</span>
        <div class="post-title-line"><h2><a href={postUrl(post.id)}>{post.data.title}</a></h2></div>
        {post.data.draft && <span class="draft-badge">草稿 · 仅本地预览</span>}
        <p>{post.data.description}</p>
        <div class="post-card-bottom">
          <div class="post-date"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{readingMinutes(post.body ?? '')} 分钟阅读</span></div>
          <a class="read-link" href={postUrl(post.id)} aria-label={`阅读文章：${post.data.title}`}>阅读文章 <Icon name="arrow" size={19} /></a>
        </div>
      </div>
    </article>
  </li>)}
</ul> : <div class="empty-state"><span class="empty-symbol" aria-hidden="true">[ &nbsp; ]</span><h2>留一点空白，给新的想法。</h2><p>文章正在慢慢积累，欢迎之后再来看看。</p></div>}
