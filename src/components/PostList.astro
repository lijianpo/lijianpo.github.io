---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl, readingMinutes, tagUrl } from '../lib/posts';
import Icon from './Icon.astro';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
{posts.length ? <ul class="post-list">
  {posts.map((post) => <li class="post-row">
    <div class="post-date"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{readingMinutes(post.body ?? '')} 分钟阅读</span></div>
    <div class="post-summary">
      <div class="post-title-line"><h2><a href={postUrl(post.id)}>{post.data.title}</a></h2><Icon name="arrow" size={20} /></div>
      {post.data.draft && <span class="draft-badge">草稿 · 仅本地预览</span>}
      <p>{post.data.description}</p>
      <div class="post-tags">{post.data.tags.map((tag) => <a href={tagUrl(tag)}><span aria-hidden="true">#</span>{tag}</a>)}</div>
    </div>
  </li>)}
</ul> : <div class="empty-state"><span class="empty-symbol" aria-hidden="true">[ &nbsp; ]</span><h2>留一点空白，给新的想法。</h2><p>文章正在慢慢积累，欢迎之后再来看看。</p></div>}
