---
import type { HoldingData } from '../lib/content-schema';
import { formatReturn, performancePlot } from '../lib/performance';

interface Props { data: HoldingData; }
const { data } = Astro.props;
const plot = performancePlot(data.points);
const latest = plot.points.at(-1)!;
const first = plot.points[0];
const lastIndex = plot.points.length - 1;
const displayDate = (date: string) => date.replaceAll('-', '.');
---

<figure class="performance-chart" data-performance-chart aria-label={data.label}>
  <figcaption>
    <span class="performance-eyebrow">收益记录</span>
    <h2>{data.label}</h2>
    <p class="performance-basis">{data.basis}</p>
  </figcaption>
  <output class="performance-readout" data-performance-readout aria-live="polite" aria-atomic="true">
    <span data-record-date>{displayDate(latest.date)}</span>
    <strong data-record-return data-trend={latest.trend}>{formatReturn(latest.returnPercent)}</strong>
  </output>
  <svg class="performance-plot" viewBox={`0 0 ${plot.width} ${plot.height}`} role="radiogroup" aria-label={`${data.label}，${plot.points.length} 个记录日`}>
    {plot.ticks.map((tick) => <g class:list={['performance-tick', { 'zero-tick': tick.value === 0 }]} aria-hidden="true">
      <line x1={plot.left} x2={plot.right} y1={tick.y} y2={tick.y} />
      <text x={plot.left - 10} y={tick.y} text-anchor="end" dominant-baseline="middle">{tick.label}</text>
    </g>)}
    {plot.line && <polyline class="performance-line" points={plot.line} fill="none" aria-hidden="true" />}
    {/* Roving tabindex: only the selected point is a Tab stop; arrow keys move between points. */}
    {plot.points.map((point, index) => <g
      class="performance-point" data-performance-point data-date={displayDate(point.date)} data-return={formatReturn(point.returnPercent)}
      data-trend={point.trend} data-selected={index === lastIndex ? 'true' : 'false'}
      tabindex={index === lastIndex ? '0' : '-1'} role="radio" aria-checked={index === lastIndex ? 'true' : 'false'}
      aria-label={`${displayDate(point.date)}，收益率 ${formatReturn(point.returnPercent)}`}
    >
      <title>{displayDate(point.date)}：{formatReturn(point.returnPercent)}</title>
      <circle class="point-target" cx={point.x} cy={point.y} r="16" />
      <circle class="point-halo" cx={point.x} cy={point.y} r="9" />
      <circle class="point-dot" cx={point.x} cy={point.y} r="4" />
    </g>)}
    <text class="performance-date" x={first.x} y={plot.bottom + 32} text-anchor={plot.points.length === 1 ? 'middle' : 'start'} aria-hidden="true">{displayDate(first.date)}</text>
    {plot.points.length > 1 && <text class="performance-date" x={latest.x} y={plot.bottom + 32} text-anchor="end" aria-hidden="true">{displayDate(latest.date)}</text>}
  </svg>
  <p class="performance-note">{plot.points.length === 1
    ? '目前只有 1 个记录日，暂以单点展示；添加后续记录后即可形成曲线。'
    : '连线连接已记录的数据点，未记录日期不补值。可点选数据点，或聚焦后用方向键查看。'}
    红色为浮盈，绿色为浮亏。</p>
  <details class="performance-records">
    <summary>查看每日记录（{plot.points.length}）</summary>
    <table>
      <caption class="sr-only">{data.label}每日数据</caption>
      <thead><tr><th scope="col">日期</th><th scope="col">收益率</th></tr></thead>
      <tbody>{plot.points.map((point) => <tr><td>{point.date}</td><td data-trend={point.trend}>{formatReturn(point.returnPercent)}</td></tr>)}</tbody>
    </table>
  </details>
</figure>

<script>
  for (const chart of document.querySelectorAll<HTMLElement>('[data-performance-chart]')) {
    const points = [...chart.querySelectorAll<SVGGElement>('[data-performance-point]')];
    const date = chart.querySelector<HTMLElement>('[data-record-date]')!;
    const value = chart.querySelector<HTMLElement>('[data-record-return]')!;
    let selectedPoint = points.find((point) => point.dataset.selected === 'true')!;
    let previewPoint: SVGGElement | undefined;
    const preview = (point?: SVGGElement) => {
      if (previewPoint) delete previewPoint.dataset.preview;
      previewPoint = point;
      if (point) point.dataset.preview = 'true';
      const record = point ?? selectedPoint;
      date.textContent = record.dataset.date!;
      value.textContent = record.dataset.return!;
      value.dataset.trend = record.dataset.trend!;
    };
    const select = (point: SVGGElement) => {
      selectedPoint = point;
      preview();
      for (const item of points) {
        const selected = item === point;
        item.dataset.selected = String(selected);
        item.setAttribute('aria-checked', String(selected));
        item.setAttribute('tabindex', selected ? '0' : '-1');
      }
    };
    const keys: Record<string, (index: number) => number> = {
      ArrowLeft: (index) => Math.max(0, index - 1),
      ArrowUp: (index) => Math.max(0, index - 1),
      ArrowRight: (index) => Math.min(points.length - 1, index + 1),
      ArrowDown: (index) => Math.min(points.length - 1, index + 1),
      Home: () => 0,
      End: () => points.length - 1,
    };
    points.forEach((point, index) => {
      // Hover previews a record without moving the keyboard's selection or Tab stop.
      point.addEventListener('pointerenter', () => preview(point));
      for (const event of ['pointerleave', 'pointercancel']) point.addEventListener(event, () => {
        if (previewPoint === point) preview();
      });
      point.addEventListener('focus', () => select(point));
      point.addEventListener('click', () => {
        select(point);
        point.focus({ preventScroll: true });
      });
      point.addEventListener('keydown', (event) => {
        if (event.key === ' ' || event.key === 'Enter') { event.preventDefault(); select(point); return; }
        const move = keys[event.key];
        if (!move) return;
        event.preventDefault();
        const target = points[move(index)];
        select(target);
        target.focus();
      });
    });
  }
</script>

<style>
  .performance-chart { margin: 32px 0; padding: 24px; border: 1px solid var(--line); border-radius: 20px; background: #fff; }
  .performance-eyebrow { display: block; font-size: 12px; color: var(--blue); }
  .performance-chart h2 { font-size: 20px; line-height: 1.5; margin: 4px 0 8px; }
  .performance-chart .performance-basis { margin: 0; color: var(--muted); font-size: 13px; }
  .performance-readout { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 18px; font-variant-numeric: tabular-nums; }
  .performance-readout span { font-size: 13px; color: var(--muted); }
  .performance-readout strong { font-size: 28px; font-weight: 500; color: var(--ink); }
  .performance-plot { width: 100%; height: auto; overflow: visible; margin-top: 12px; }
  .performance-tick line { stroke: #e8eaed; stroke-width: 1; }
  .performance-tick text, .performance-date { fill: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
  .zero-tick line { stroke: #9aa0a6; stroke-dasharray: 4 4; }
  .performance-line { stroke: var(--blue); stroke-width: 2; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .performance-point { cursor: pointer; outline: none; }
  .point-target { fill: transparent; }
  .point-halo { fill: var(--blue-soft); opacity: 0; }
  .point-dot { fill: var(--blue); stroke: white; stroke-width: 1.5; }
  .performance-point[data-selected='true'] .point-halo, .performance-point[data-preview='true'] .point-halo, .performance-point:focus-visible .point-halo { opacity: 1; }
  .performance-point:focus-visible .point-halo { stroke: var(--blue); stroke-width: 2; }
  .performance-chart .performance-note { margin: 12px 0; font-size: 12px; color: var(--muted); line-height: 1.7; }
  .performance-records { border-top: 1px solid var(--line); padding-top: 12px; font-size: 13px; }
  .performance-records summary { cursor: pointer; color: var(--blue); }
  .performance-records td:last-child, .performance-records th:last-child { text-align: right; font-variant-numeric: tabular-nums; }
  /* A-share convention: gains red, losses green. Signs (+/−) carry the same meaning without color. */
  .performance-readout strong[data-trend='gain'], .performance-records td[data-trend='gain'] { color: var(--gain); }
  .performance-readout strong[data-trend='loss'], .performance-records td[data-trend='loss'] { color: var(--loss); }
  .performance-point[data-trend='gain'] .point-dot { fill: var(--gain); }
  .performance-point[data-trend='loss'] .point-dot { fill: var(--loss); }
  .performance-point[data-trend='gain'] .point-halo { fill: var(--gain-soft); }
  .performance-point[data-trend='loss'] .point-halo { fill: var(--loss-soft); }
  .performance-point[data-trend='gain']:focus-visible .point-halo { stroke: var(--gain); }
  .performance-point[data-trend='loss']:focus-visible .point-halo { stroke: var(--loss); }
  @media (max-width: 480px) {
    .performance-chart { padding: 16px 12px; border-radius: 16px; }
    .performance-chart h2 { font-size: 18px; }
    .performance-tick text, .performance-date { font-size: 20px; }
  }
</style>
