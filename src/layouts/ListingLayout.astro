---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import PostList from '../components/PostList.astro';
import PostViewToggle from '../components/PostViewToggle.astro';
import Pagination from '../components/Pagination.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import { site } from '../site.config';
interface Props { posts: CollectionEntry<'posts'>[]; current: number; total: number; count: number; }
const { posts, current, total, count } = Astro.props;
---
<BaseLayout title={current > 1 ? `文章 · 第 ${current} 页` : undefined}>
  <script slot="head" is:inline>
    // Restore the layout before the article list is painted.
    (() => {
      let view = 'list';
      try {
        if (localStorage.getItem('blog-post-view') === 'cards') view = 'cards';
      } catch { /* The default list also works when storage is unavailable. */ }
      document.documentElement.dataset.postView = view;
    })();
  </script>
  <div class="page-container home-container">
    {current === 1 ? <header class="home-intro">
      <p class="eyebrow">一个持续生长的个人博客</p>
      <h1>{site.tagline}<span class="title-period">。</span></h1>
      <p>保持好奇，把探索的过程、生活的发现，慢慢写下来。</p>
    </header> : <PageHeading eyebrow="THE JOURNAL" title="更多文章" description="顺着时间，继续读下去。" count={`第 ${current} 页 · 共 ${count} 篇`} />}
    <div class="list-toolbar">
      <h2>{current === 1 ? '最新文章' : '全部文章'}<span>{count} 篇记录</span></h2>
      <div class="list-toolbar-actions">
        {posts.length > 0 && <PostViewToggle controls="home-posts" />}
        <a class="archive-link" href="/archives/">查看归档 <Icon name="arrow" size={18} /></a>
      </div>
    </div>
    <PostList id="home-posts" posts={posts} featured={current === 1} switchable />
    <Pagination current={current} total={total} />
    <section class="rss-note" aria-labelledby="subscribe-title">
      <div class="rss-illustration" aria-hidden="true"><Icon name="rss" size={38} /><BrandMark /></div>
      <div class="rss-copy"><h2 id="subscribe-title">让下一篇发现，来找你。</h2><p>通过 RSS 订阅，在你喜欢的阅读器里，继续这段探索。</p></div>
      <a class="subscribe-link" href="/rss.xml">订阅更新 <Icon name="arrow" size={19} /></a>
    </section>
  </div>
</BaseLayout>
